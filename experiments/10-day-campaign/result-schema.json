{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G-FShield 10-day campaign result",
  "type": "object",
  "required": [
    "campaign_id", "arm_id", "run_id", "seed", "stage", "algorithm",
    "classifier", "classifier_version", "dataset_hash", "train_hash",
    "validation_hash", "test_hash", "timestamp_utc",
    "monotonic_elapsed_ms", "status", "stop_reason"
  ],
  "properties": {
    "campaign_id": {"type": "string"},
    "arm_id": {"type": "string"},
    "run_id": {"type": "string"},
    "seed": {"type": "integer"},
    "candidate_id": {"type": ["string", "null"]},
    "parent_id": {"type": ["string", "null"]},
    "request_id": {"type": ["string", "null"]},
    "stage": {"type": "string"},
    "algorithm": {"type": "string"},
    "feature_selector": {"type": ["string", "null"]},
    "neighborhood_controller": {"type": ["string", "null"]},
    "local_search": {"type": ["string", "null"]},
    "classifier": {"type": "string"},
    "classifier_version": {"type": "string"},
    "classifier_parameters": {"type": "object"},
    "dataset_hash": {"type": "string"},
    "train_hash": {"type": "string"},
    "validation_hash": {"type": "string"},
    "test_hash": {"type": "string"},
    "selected_features": {"type": "array", "items": {"type": ["integer", "string"]}},
    "subset_size": {"type": ["integer", "null"]},
    "dimensionality_reduction_percent": {"type": ["number", "null"]},
    "validation_f1_macro": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "validation_f1_weighted": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "validation_precision_macro": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "validation_precision_weighted": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "validation_recall_macro": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "validation_recall_weighted": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "test_f1_macro": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "test_f1_weighted": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "test_precision_macro": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "test_recall_macro": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "class_labels": {"type": "array", "items": {"type": "string"}},
    "validation_per_class_metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["f1", "precision", "recall"],
        "properties": {
          "f1": {"type": "number", "minimum": 0, "maximum": 1},
          "precision": {"type": "number", "minimum": 0, "maximum": 1},
          "recall": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "test_per_class_metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["f1", "precision", "recall"],
        "properties": {
          "f1": {"type": "number", "minimum": 0, "maximum": 1},
          "precision": {"type": "number", "minimum": 0, "maximum": 1},
          "recall": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "validation_confusion_matrix": {
      "type": "array",
      "items": {"type": "array", "items": {"type": "number", "minimum": 0}}
    },
    "test_confusion_matrix": {
      "type": "array",
      "items": {"type": "array", "items": {"type": "number", "minimum": 0}}
    },
    "candidate_time_ms": {"type": ["integer", "null"], "minimum": 0},
    "classifier_time_ms": {"type": ["integer", "null"], "minimum": 0},
    "run_elapsed_ms": {"type": ["integer", "null"], "minimum": 0},
    "end_to_end_time_ms": {"type": ["integer", "null"], "minimum": 0},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "monotonic_elapsed_ms": {"type": "integer", "minimum": 0},
    "candidate_count": {"type": ["integer", "null"], "minimum": 0},
    "accepted_improvement_count": {"type": ["integer", "null"], "minimum": 0},
    "process_cpu_percent": {"type": ["number", "null"]},
    "container_cpu_percent": {"type": ["number", "null"]},
    "host_cpu_percent": {"type": ["number", "null"]},
    "process_rss_mb": {"type": ["number", "null"]},
    "container_memory_mb": {"type": ["number", "null"]},
    "host_memory_mb": {"type": ["number", "null"]},
    "cpu_throttled_seconds": {"type": ["number", "null"]},
    "disk_read_bytes": {"type": ["integer", "null"]},
    "disk_write_bytes": {"type": ["integer", "null"]},
    "network_rx_bytes": {"type": ["integer", "null"]},
    "network_tx_bytes": {"type": ["integer", "null"]},
    "kafka_lag": {"type": ["integer", "null"]},
    "restart_count": {"type": ["integer", "null"]},
    "stop_reason": {"type": "string"},
    "status": {"enum": ["completed", "timeout", "timeout_forced", "failed", "oom", "cancelled"]},
    "error_code": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
