      "iwssr": {"cpu": 3.0, "memory_gib": 4},
      "vnd": {"cpu": 0.5, "memory_gib": 1},
      "verifier": {"cpu": 0.5, "memory_gib": 1},
      "kafka": {"cpu": 0.75, "memory_gib": 2},
      "zookeeper": {"cpu": 0.25, "memory_gib": 1}
    },
    "worker_parameter_changes_only": [
      "local-search consumer concurrency",
      "controller consumer concurrency",
      "verifier consumer concurrency",
      "Kafka partition count"
    ]
  },
  "dataset": {
    "split_manifest": "datasets/campaign/split-manifest.json",
    "source_sha256": "60ebfcdc9c209e5c760e2bdbf5be75dfe4d931b81442597b0ef32e2f5fe6c1f6",
    "train_sha256": "5876bf5570b7f71d7bc4eb51ebb1792f6e7357c7010cce78248a121420a870af",
    "validation_sha256": "c44a00ca554c63e8134e01e1e5a2b2c1c167e4bcd02cd6e318d3d602a5f1031a",
    "test_sha256": "05d393c5881aec032664ef4a84e18337988e819edc74664fe1255757961cfab4"
  },
  "hypotheses": {
    "preregistration": "Frozen before observing seeds 102--126.",
    "quality_threshold_validation_macro_f1": 0.945,
    "primary": "positive paired mean slope of normalized quality-yield AUC against log2(workers) over distributed-w1, distributed-w2, and distributed-w4",
    "primary_test": "one-sided paired sign-flip permutation test over the 25 per-seed slopes at alpha 0.05",
    "quality_yield_auc": "time integral of the cumulative count of distinct subsets with validation macro-F1 at least 0.945, divided by the 2700-second horizon",
    "architecture_contrast": "distributed-w1 minus monolith estimates the effect of stage overlap without multiple consumers",
    "scaling_contrast": "distributed-w4 minus distributed-w1 estimates the effect of added consumer concurrency under the same aggregate resource ceiling",
    "quality_guardrail": "the one-sided 95% bootstrap lower bound for held-out macro-F1, distributed-w4 minus monolith, must be at least -0.005",
    "dose_response_guardrail": "mean quality-yield AUC must be nondecreasing from distributed-w1 to distributed-w2 to distributed-w4",
    "mechanism_guardrail": "median construction/local-search overlap must be positive in every distributed arm and zero in the monolith",
    "secondary_family": [
      "quality-yield AUC pairwise contrasts",
      "distinct qualified subsets at deadline",
      "time to first qualified subset",
      "candidate throughput",
      "CPU-hours and GiB-hours per qualified subset",
      "Kafka backlog and lag where available",
      "held-out macro-F1 and dimensionality reduction"
    ],
    "multiplicity": "Holm correction within the secondary pairwise family"
  }
}
