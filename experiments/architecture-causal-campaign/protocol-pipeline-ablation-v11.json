{
  "schema_version": 1,
  "campaign_id": "gfshield-pipeline-ablation-2026-v11",
  "maximum_seconds": 864000,
  "run_timeout_seconds": 3000,
  "finalization_reserve_seconds": 300,
  "startup_timeout_seconds": 300,
  "graceful_shutdown_seconds": 300,
  "maximum_attempts_per_cell": 3,
  "seeds": [
    102, 103, 104, 105, 106, 107, 108, 109, 110, 111,
    112, 113, 114, 115, 116, 117, 118, 119, 120, 121,
    122, 123, 124, 125, 126
  ],
  "arms": [
    {"id": "monolith", "architecture": "monolith", "pipeline_workers": 0},
    {"id": "distributed-w1", "architecture": "distributed", "pipeline_workers": 1},
    {"id": "distributed-w2", "architecture": "distributed", "pipeline_workers": 2},
    {"id": "distributed-w4", "architecture": "distributed", "pipeline_workers": 4}
  ],
  "order_design": {
    "type": "four-treatment Williams design",
    "orders": [
      ["monolith", "distributed-w1", "distributed-w4", "distributed-w2"],
      ["distributed-w1", "distributed-w2", "monolith", "distributed-w4"],
      ["distributed-w2", "distributed-w4", "distributed-w1", "monolith"],
      ["distributed-w4", "monolith", "distributed-w2", "distributed-w1"]
    ]
  },
  "measurement_window": {
    "selection_seconds": 2700,
    "cold_start_reported_separately": true,
    "final_evaluation_excluded_from_search_resource_costs": true,
    "post_deadline_candidates_excluded": true,
    "origin": "request_submission_after_distributed_service_readiness"
