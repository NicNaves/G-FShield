  "algorithm": {
    "feature_selector": "relieff",
    "relieff_sample_size": 1000,
    "rcl_cutoff": 30,
    "initial_subset_size": 5,
    "controller": "vnd",
    "enabled_local_searches": ["iwssr"],
    "training_dataset_cache": true,
    "neighborhood_cycles": 100,
    "local_search_iterations": 100,
    "minimum_improvement": 0.0001,
    "maximum_accepted_improvements": 500,
    "classifier": "Weka J48 3.8.6",
    "classifier_parameters": {
      "confidence_factor": 0.25,
      "minimum_instances_per_leaf": 2,
      "pruned": true
    },
    "selection_metric": "validation_macro_f1",
    "holdout_policy": "test_once_after_validation_selection"
  },
  "resources": {
    "cpuset": "8-15",
    "numa_node": "1",
    "aggregate_cpu_ceiling": 6,
    "aggregate_memory": "12g",
    "distributed_component_ceiling_sum": {
